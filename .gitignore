# Checkpoints and Model Weights (keep manifest/reports, ignore >100MB binaries if any)
*.pth
*.pt
*.onnx
checkpoints/*.pth
checkpoints/*.pt
checkpoints/*.onnx
!checkpoints/.gitkeep
experiments/*/checkpoints/

# Logs and TensorBoard runs
logs/*.log
logs/events.*
